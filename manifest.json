{
  "manifest_version": 3,
  "name": "Bloqueador IA",
  "version": "0.1.0",
  "description": "Bloquea el contenido generado por IA en TikTok, YouTube, Facebook, Instagram, ReelShort y X.",
  "permissions": ["storage"],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.youtube.com/*",
        "*://*.tiktok.com/*",
        "*://*.facebook.com/*",
        "*://*.instagram.com/*",
        "*://*.reelshort.com/*",
        "*://*.x.com/*"
      ],
      "js": ["src/rules.js", "src/content.js"],
      "css": ["src/content.css"],
      "run_at": "document_idle"
    }
  ]
}
